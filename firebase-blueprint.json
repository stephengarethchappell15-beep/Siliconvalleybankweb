{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered bank user account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "accountNumber": { "type": "string" },
        "role": { "type": "string" },
        "balance": { "type": "number" },
        "ledgerBalance": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "email", "fullName"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Live support chat ticket with messages and attachments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "subject": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "messages": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "subject", "messages", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User documents by ID"
    },
    "/users_by_email/{email}": {
      "schema": "User",
      "description": "User lookup documents by email"
    },
    "/users_by_account/{accNo}": {
      "schema": "User",
      "description": "User lookup documents by account number"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Live chat and customer support inquiries"
    }
  }
}
